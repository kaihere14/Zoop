# Copy to ~/.zoop/config.json (preferred; see Docs/AgentLayer.md) or export these in your shell.
# Environment variables override the config file. Never commit real keys.

# Provider and model per agent. Providers: anthropic, gemini, openrouter, groq, openai, ollama, lmstudio, custom.
# List the model names your key offers with: swift run zoop-agent models --provider <provider>
ZOOP_EXECUTOR_PROVIDER=gemini
ZOOP_EXECUTOR_MODEL=<model name>
# ZOOP_PLANNER_PROVIDER=gemini  # configure a stronger planner; otherwise falls back to executor
# ZOOP_PLANNER_MODEL=<model name>
# ZOOP_CHAT_PROVIDER=gemini
# ZOOP_CHAT_MODEL=<model name>
# ZOOP_EXECUTOR_BASE_URL=   # only for the custom provider

# Provider keys (set the ones you use)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # Claude, e.g. ZOOP_EXECUTOR_MODEL=claude-haiku-5-5
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional paths
# ZOOP_CONFIG=~/.zoop/config.json
# ZOOP_SHARED_ROOT=/Users/Shared/Zoop
# ZOOP_SOCKET=/Users/Shared/Zoop/run/helper.sock

# Helper only: UIDs (comma-separated) allowed to connect to the helper socket.
# Set this to the UID of the main user (`id -u` in the main session).
# ZOOP_ALLOWED_UIDS=501
