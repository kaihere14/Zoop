# Copy to ~/.zoop/config.json (preferred) or export these in your shell.
# Environment variables override the config file.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ZOOP_CHAT_MODEL=claude-haiku-5-5
# ZOOP_EXECUTOR_MODEL=claude-sonnet-5-5
# ZOOP_SHARED_ROOT=/Users/Shared/Zoop
# ZOOP_SOCKET=/Users/Shared/Zoop/run/helper.sock

# Helper only: UIDs (comma-separated) allowed to connect to the helper socket.
# Set this to the UID of the main user (`id -u` in the main session).
# ZOOP_ALLOWED_UIDS=501
